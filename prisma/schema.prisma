generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum StockMovementType {
  PURCHASE
  SALE
  WASTE
  ADJUSTMENT
  RETURN
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(CASHIER)
  active       Boolean     @default(true)
  sessionVersion Int        @default(0)
  orders       Order[]
  shifts       Shift[]
  auditEvents  AuditEvent[]
  refundsProcessed Refund[]
  itemReturnsProcessed OrderLineReturn[]
  cashMovements CashMovement[]
  purchaseOrders PurchaseOrder[]
  discountApprovalsAsCashier DiscountApproval[] @relation("DiscountCashier")
  discountApprovalsAsManager DiscountApproval[] @relation("DiscountManager")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  sku         String?       @unique
  priceMinor  Int
  currency    String        @default("AFN")
  status      ProductStatus @default(ACTIVE)
  available   Boolean       @default(true)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  orderLines  OrderLine[]
  recipeItems RecipeItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId, status, available])
}

model Ingredient {
  id             String          @id @default(cuid())
  name           String
  unit           String
  quantityOnHand Decimal         @default(0) @db.Decimal(14, 3)
  reorderLevel   Decimal         @default(0) @db.Decimal(14, 3)
  averageCostMinor Int           @default(0)
  purchaseOrderLines PurchaseOrderLine[]
  recipeItems    RecipeItem[]
  movements      StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model RecipeItem {
  id           String     @id @default(cuid())
  productId    String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 3)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId])
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    Int           @unique @default(autoincrement())
  status         OrderStatus   @default(DRAFT)
  cashierId      String
  cashier        User          @relation(fields: [cashierId], references: [id])
  shiftId        String?
  shift          Shift?        @relation(fields: [shiftId], references: [id])
  customerName   String?
  subtotalMinor  Int
  discountMinor  Int           @default(0)
  taxMinor       Int           @default(0)
  totalMinor     Int
  currency       String        @default("AFN")
  idempotencyKey String?       @unique
  requestFingerprint String?
  lines          OrderLine[]
  payments       Payment[]
  refunds        Refund[]
  itemReturns    OrderLineReturn[]
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  @@index([status, createdAt])
}

model OrderLine {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  productName     String
  quantity        Int
  unitPriceMinor  Int
  lineTotalMinor  Int
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])
  returns         OrderLineReturn[]

  @@index([orderId])
  @@unique([id, orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  method            PaymentMethod
  status            PaymentStatus  @default(PENDING)
  amountMinor       Int
  currency          String         @default("AFN")
  providerReference String?
  cashReceivedMinor  Int?
  changeDueMinor     Int?
  createdAt         DateTime       @default(now())

  @@index([orderId, status])
}

model Shift {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  orders            Order[]
  cashMovements     CashMovement[]
  openingCashMinor  Int
  closingCashMinor  Int?
  expectedCashMinor Int?
  openedAt          DateTime     @default(now())
  closedAt          DateTime?

  @@index([userId, closedAt])
}

model StockMovement {
  id           String            @id @default(cuid())
  ingredientId String
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id])
  type         StockMovementType
  quantity     Decimal           @db.Decimal(14, 3)
  reason       String?
  referenceId  String?
  createdAt    DateTime          @default(now())

  @@index([ingredientId, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model LoginAttempt {
  key             String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
}

model PosSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}


enum CashMovementType {
  PAID_IN
  PAID_OUT
}

enum RefundKind {
  REFUND
  VOID
}

model Refund {
  id            String     @id @default(cuid())
  orderId       String
  order         Order      @relation(fields: [orderId], references: [id])
  processedById String
  processedBy   User       @relation(fields: [processedById], references: [id])
  kind          RefundKind
  amountMinor   Int
  currency      String
  reason        String
  cashRefundMinor Int        @default(0)
  otherRefundMinor Int       @default(0)
  taxRefundMinor   Int        @default(0)
  createdAt     DateTime   @default(now())

  @@index([orderId, createdAt])
  @@index([processedById, createdAt])
}


model CashMovement {
  id          String           @id @default(cuid())
  shiftId     String
  shift       Shift            @relation(fields: [shiftId], references: [id])
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  type        CashMovementType
  amountMinor Int
  reason      String
  createdAt   DateTime         @default(now())

  @@index([shiftId, createdAt])
  @@index([userId, createdAt])
}


model DiscountApproval {
  id             String   @id @default(cuid())
  cashierId      String
  cashier        User     @relation("DiscountCashier", fields: [cashierId], references: [id])
  managerId      String
  manager        User     @relation("DiscountManager", fields: [managerId], references: [id])
  subtotalMinor  Int
  discountMinor  Int
  cartFingerprint String
  reason         String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([cashierId, expiresAt, usedAt])
  @@index([managerId, createdAt])
}


enum ReturnCondition {
  SEALED_UNUSED
  OPENED
  PREPARED
  DAMAGED
}

enum ReturnDisposition {
  WASTE
  NOT_RESTOCKABLE
}

enum PurchaseOrderStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model OrderLineReturn {
  id             String            @id @default(cuid())
  orderId        String
  orderLineId    String
  processedById  String
  quantity       Int
  condition      ReturnCondition
  disposition    ReturnDisposition
  reason         String
  createdAt      DateTime          @default(now())
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine      OrderLine         @relation(fields: [orderLineId, orderId], references: [id, orderId], onDelete: Cascade)
  processedBy    User              @relation(fields: [processedById], references: [id])

  @@index([orderId, createdAt])
  @@index([orderLineId, createdAt])
}


model Supplier {
  id        String         @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  active    Boolean        @default(true)
  orders    PurchaseOrder[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([active, name])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  orderNumber    Int                 @unique @default(autoincrement())
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  currency       String              @default("AFN")
  subtotalMinor  Int
  notes          String?
  lines          PurchaseOrderLine[]
  createdAt      DateTime            @default(now())
  receivedAt     DateTime?

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
}

model PurchaseOrderLine {
  id                String        @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId      String
  ingredient        Ingredient    @relation(fields: [ingredientId], references: [id])
  ingredientName    String
  quantity          Decimal       @db.Decimal(14, 3)
  receivedQuantity  Decimal       @default(0) @db.Decimal(14, 3)
  unitCostMinor     Int
  lineTotalMinor    Int

  @@index([purchaseOrderId])
}
