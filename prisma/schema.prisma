generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
}

enum StaffApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum StockMovementType {
  PURCHASE
  SALE
  WASTE
  ADJUSTMENT
  RETURN
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  timezone  String   @default("Asia/Kabul")
  currency  String   @default("AFN")
  active    Boolean  @default(true)
  users     User[]
  shifts    Shift[]
  categories Category[]
  products Product[]
  ingredients Ingredient[]
  suppliers Supplier[]
  purchaseOrders PurchaseOrder[]
  diningTables DiningTable[]
  settings BranchSetting[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, name])
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  phone        String?
  photoUrl     String?
  employeeCode String?     @unique
  branchId     String
  branch       Branch      @relation(fields: [branchId], references: [id])
  passwordHash String
  role         UserRole    @default(CASHIER)
  active       Boolean     @default(true)
  approvalStatus StaffApprovalStatus @default(APPROVED)
  sessionVersion Int        @default(0)
  permissionOverrides Json  @default("{}")
  orders       Order[]
  shifts       Shift[]
  auditEvents  AuditEvent[]
  refundsProcessed Refund[]
  itemReturnsProcessed OrderLineReturn[]
  cashMovements CashMovement[]
  purchaseOrders PurchaseOrder[]
  supplierPayments SupplierPayment[]
  discountApprovalsAsCashier DiscountApproval[] @relation("DiscountCashier")
  discountApprovalsAsManager DiscountApproval[] @relation("DiscountManager")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  branchId  String    @default("main-branch")
  branch    Branch    @relation(fields: [branchId], references: [id])
  name      String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([branchId, name])
  @@index([branchId, active, sortOrder])
}

model Product {
  id          String        @id @default(cuid())
  branchId    String        @default("main-branch")
  branch      Branch        @relation(fields: [branchId], references: [id])
  name        String
  description String?
  imageUrl    String?
  sku         String?       @unique
  priceMinor  Int
  currency    String        @default("AFN")
  status      ProductStatus @default(ACTIVE)
  available   Boolean       @default(true)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  orderLines  OrderLine[]
  recipeItems RecipeItem[]
  variants ProductVariant[]
  modifierGroups ProductModifierGroup[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([branchId, status, available])
  @@index([categoryId, status, available])
}

model Ingredient {
  id             String          @id @default(cuid())
  branchId       String          @default("main-branch")
  branch         Branch          @relation(fields: [branchId], references: [id])
  name           String
  unit           String
  quantityOnHand Decimal         @default(0) @db.Decimal(14, 3)
  reorderLevel   Decimal         @default(0) @db.Decimal(14, 3)
  averageCostMinor Int           @default(0)
  purchaseOrderLines PurchaseOrderLine[]
  recipeItems    RecipeItem[]
  movements      StockMovement[]
  variantRecipes VariantRecipeItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([branchId, name])
  @@index([branchId, quantityOnHand])
}

model RecipeItem {
  id           String     @id @default(cuid())
  productId    String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 3)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId])
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    Int           @unique @default(autoincrement())
  status         OrderStatus   @default(DRAFT)
  cashierId      String
  cashier        User          @relation(fields: [cashierId], references: [id])
  shiftId        String?
  shift          Shift?        @relation(fields: [shiftId], references: [id])
  tableId        String?
  table          DiningTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerName   String?
  notes          String?
  subtotalMinor  Int
  discountMinor  Int           @default(0)
  taxMinor       Int           @default(0)
  totalMinor     Int
  currency       String        @default("AFN")
  idempotencyKey String?       @unique
  requestFingerprint String?
  lines          OrderLine[]
  payments       Payment[]
  refunds        Refund[]
  itemReturns    OrderLineReturn[]
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  @@index([status, createdAt])
  @@index([tableId, status])
}

model OrderLine {
  id              String  @id @default(cuid())
  orderId         String
  productId       String
  productName     String
  quantity        Int
  unitPriceMinor  Int
  lineTotalMinor  Int
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])
  returns         OrderLineReturn[]
  variantName     String?
  selectedModifiers Json?

  @@index([orderId])
  @@unique([id, orderId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  method            PaymentMethod
  status            PaymentStatus  @default(PENDING)
  amountMinor       Int
  currency          String         @default("AFN")
  providerReference String?
  cashReceivedMinor  Int?
  changeDueMinor     Int?
  createdAt         DateTime       @default(now())

  @@index([orderId, status])
}

model Shift {
  id                String       @id @default(cuid())
  branchId          String
  branch            Branch       @relation(fields: [branchId], references: [id])
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  orders            Order[]
  cashMovements     CashMovement[]
  refunds           Refund[]
  openingCashMinor  Int
  openingNote       String?
  closingCashMinor  Int?
  closingNote       String?
  expectedCashMinor Int?
  openedAt          DateTime     @default(now())
  closedAt          DateTime?

  @@index([userId, closedAt])
  @@index([branchId, openedAt])
}

model StockMovement {
  id           String            @id @default(cuid())
  ingredientId String
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id])
  type         StockMovementType
  quantity     Decimal           @db.Decimal(14, 3)
  reason       String?
  referenceId  String?
  createdAt    DateTime          @default(now())

  @@index([ingredientId, createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model LoginAttempt {
  key             String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
}

model BranchSetting {
  id        String   @id @default(cuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([branchId, key])
  @@index([branchId])
}

model PosSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}


enum CashMovementType {
  PAID_IN
  PAID_OUT
}

enum RefundKind {
  REFUND
  VOID
}

model Refund {
  id            String     @id @default(cuid())
  orderId       String
  order         Order      @relation(fields: [orderId], references: [id])
  processedById String
  processedBy   User       @relation(fields: [processedById], references: [id])
  shiftId       String?
  shift         Shift?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  kind          RefundKind
  amountMinor   Int
  currency      String
  reason        String
  cashRefundMinor Int        @default(0)
  otherRefundMinor Int       @default(0)
  taxRefundMinor   Int        @default(0)
  createdAt     DateTime   @default(now())

  @@index([orderId, createdAt])
  @@index([processedById, createdAt])
  @@index([shiftId, createdAt])
}


model CashMovement {
  id          String           @id @default(cuid())
  shiftId     String
  shift       Shift            @relation(fields: [shiftId], references: [id])
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  type        CashMovementType
  amountMinor Int
  reason      String
  createdAt   DateTime         @default(now())

  @@index([shiftId, createdAt])
  @@index([userId, createdAt])
}


model DiscountApproval {
  id             String   @id @default(cuid())
  cashierId      String
  cashier        User     @relation("DiscountCashier", fields: [cashierId], references: [id])
  managerId      String
  manager        User     @relation("DiscountManager", fields: [managerId], references: [id])
  subtotalMinor  Int
  discountMinor  Int
  cartFingerprint String
  reason         String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([cashierId, expiresAt, usedAt])
  @@index([managerId, createdAt])
}


enum ReturnCondition {
  SEALED_UNUSED
  OPENED
  PREPARED
  DAMAGED
}

enum ReturnDisposition {
  WASTE
  NOT_RESTOCKABLE
}

enum PurchaseOrderStatus {
  DRAFT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierInvoiceStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum SupplierPaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

model OrderLineReturn {
  id             String            @id @default(cuid())
  orderId        String
  orderLineId    String
  processedById  String
  quantity       Int
  condition      ReturnCondition
  disposition    ReturnDisposition
  reason         String
  createdAt      DateTime          @default(now())
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine      OrderLine         @relation(fields: [orderLineId, orderId], references: [id, orderId], onDelete: Cascade)
  processedBy    User              @relation(fields: [processedById], references: [id])

  @@index([orderId, createdAt])
  @@index([orderLineId, createdAt])
}


model Supplier {
  id        String         @id @default(cuid())
  branchId  String         @default("main-branch")
  branch    Branch         @relation(fields: [branchId], references: [id])
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  active    Boolean        @default(true)
  orders    PurchaseOrder[]
  invoices  SupplierInvoice[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([branchId, active, name])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  branchId       String              @default("main-branch")
  branch         Branch              @relation(fields: [branchId], references: [id])
  orderNumber    Int                 @unique @default(autoincrement())
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  createdById    String
  createdBy      User                @relation(fields: [createdById], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  currency       String              @default("AFN")
  subtotalMinor  Int
  notes          String?
  lines          PurchaseOrderLine[]
  invoices       SupplierInvoice[]
  createdAt      DateTime            @default(now())
  receivedAt     DateTime?

  @@index([supplierId, createdAt])
  @@index([branchId, status, createdAt])
}

model PurchaseOrderLine {
  id                String        @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId      String
  ingredient        Ingredient    @relation(fields: [ingredientId], references: [id])
  ingredientName    String
  quantity          Decimal       @db.Decimal(14, 3)
  receivedQuantity  Decimal       @default(0) @db.Decimal(14, 3)
  unitCostMinor     Int
  lineTotalMinor    Int

  invoices          SupplierInvoiceLine[]

  @@index([purchaseOrderId])
}

model SupplierInvoice {
  id              String                @id @default(cuid())
  supplierId      String
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  invoiceNumber   String
  currency        String
  totalMinor      Int
  status          SupplierInvoiceStatus @default(OPEN)
  invoiceDate     DateTime
  dueDate         DateTime?
  notes           String?
  lines           SupplierInvoiceLine[]
  payments        SupplierPayment[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([supplierId, invoiceNumber])
  @@index([purchaseOrderId, createdAt])
  @@index([status, dueDate])
}

model SupplierInvoiceLine {
  id                String             @id @default(cuid())
  invoiceId         String
  invoice           SupplierInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  quantity          Decimal            @db.Decimal(14, 3)
  unitCostMinor     Int
  lineTotalMinor    Int

  @@unique([invoiceId, purchaseOrderLineId])
}

model SupplierPayment {
  id          String                @id @default(cuid())
  invoiceId   String
  invoice     SupplierInvoice       @relation(fields: [invoiceId], references: [id])
  amountMinor Int
  currency    String
  method      SupplierPaymentMethod
  reference   String?
  notes       String?
  paidAt      DateTime              @default(now())
  createdById String
  createdBy   User                  @relation(fields: [createdById], references: [id])
  createdAt   DateTime              @default(now())

  @@index([invoiceId, paidAt])
}


model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  sku         String?  @unique
  priceMinor  Int
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  recipeItems VariantRecipeItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, active, sortOrder])
}

model VariantRecipeItem {
  id           String         @id @default(cuid())
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id])
  quantity     Decimal        @db.Decimal(14, 3)

  @@unique([variantId, ingredientId])
}

model ProductModifierGroup {
  id             String           @id @default(cuid())
  productId      String
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  required       Boolean          @default(false)
  minSelections  Int              @default(0)
  maxSelections  Int              @default(1)
  active         Boolean          @default(true)
  sortOrder      Int              @default(0)
  options        ProductModifierOption[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([productId, active, sortOrder])
}

model ProductModifierOption {
  id             String                @id @default(cuid())
  groupId        String
  group          ProductModifierGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name           String
  priceDeltaMinor Int                  @default(0)
  active         Boolean               @default(true)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([groupId, active, sortOrder])
}


model DiningTable {
  id        String   @id @default(cuid())
  branchId  String   @default("main-branch")
  branch    Branch   @relation(fields: [branchId], references: [id])
  name      String
  section   String?
  capacity  Int      @default(2)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, name])
  @@index([branchId, active, sortOrder, name])
}
