# Set this in Vercel Project Settings > Environment Variables.
# Never commit a real connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Required for staff session signing. Generate with: openssl rand -base64 48
POS_SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Optional initial owner account, used only by prisma db:seed.
# Set these securely in the deployment environment before running the seed.
POS_OWNER_NAME="Store Owner"
POS_OWNER_EMAIL="owner@example.com"
POS_OWNER_PASSWORD="replace-with-a-unique-password-at-least-12-characters"
